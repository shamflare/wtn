# الموجّه: يستقبل الطلبات ويمرّرها إلى الموقع، ويصنع شهادة HTTPS وحده
# ويجدّدها وحده — بلا خطوة يدوية تُنسى بعد تسعين يوماً.

{
	# بريدٌ لتنبيهات الشهادة من Let's Encrypt
	email alayatl.tr@gmail.com
}

# العناوين من `SITE_ADDRESSES` في deploy/.env — فالملفّ نفسه يخدم كل نسخةٍ بدومينها
# (ahlacard.com لعميل، wtn4.com لنا). وغيابُه يُبقي wtn4.com كما كان.
{$SITE_ADDRESSES:wtn4.com, www.wtn4.com, api.wtn4.com} {
	encode zstd gzip

	# الردود على `/client/api/` تخصّ عملاء خارجيين لا متصفّحات، ولا تُخزَّن
	header /client/api/* Cache-Control "no-store"

	reverse_proxy web:8000 {
		# بدونهما يرى Django عنوان الموجّه لا عنوان الزائر، ويظنّ الاتصال
		# غير مشفّر فيعيد التوجيه إلى https إلى ما لا نهاية.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# عناوين المتاجر (`islam.wtn4.com`) في ملفٍّ منفصل: [stores.caddy](stores.caddy).
#
# يُلحق بهذا الملف عند الإقلاع **إن وُجد `CF_API_TOKEN`** في `deploy/.env`،
# ويُترك إن غاب. فنسيان المفتاح يعطّل الميزة ولا يُسقط الموقع — وقد أسقطه
# مرّةً حين كانت الكتلة هنا (انظر رأس `stores.caddy`).
