# أسرار الموقع — انسخه إلى deploy/.env واملأه. لا يدخل المستودع أبداً.

# openssl rand -base64 48
SECRET_KEY=

# ── القاعدة: على الخادم نفسه، في حاوية `db` ──────────────────────────
# openssl rand -base64 32   (بلا `@` و`/` و`:` — تُربك قراءة الرابط)
POSTGRES_PASSWORD=
POSTGRES_USER=wtn
POSTGRES_DB=wtn

# نفس الكلمة أعلاه. و`db` اسم الحاوية داخل شبكة Docker لا عنوانٌ على الإنترنت،
# ولذلك `sslmode=disable` صراحةً: settings.py يفرض `require` حين لا يُذكر —
# وهو الصواب لقاعدةٍ بعيدة، لا لقاعدةٍ على الجسر الداخلي نفسه.
DATABASE_URL=postgresql://wtn:CHANGE_ME@db:5432/wtn?sslmode=disable

# النطاقات المسموح بها — كان "*" على Render، وهو مفتوحٌ لكل عنوان
# `web` هو اسم الموقع **داخل شبكة Docker** — ينادي به البوت. بدونه يردّ
# Django بـ 400 على كل نبضة، والرسالة لا تقول أن الاسم هو السبب.
ALLOWED_HOSTS=wtn4.com,www.wtn4.com,api.wtn4.com,46.224.47.213,web,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://wtn4.com,https://www.wtn4.com,https://api.wtn4.com

DEBUG=0

# ── هويّة النسخة — كل عميلٍ بدومينه (plan2.md) ─────────────────────────
# دومين هذه النسخة، وعناوين الموجّه (تُصدَر لها الشهادة)
PLATFORM_DOMAIN=wtn4.com
SITE_ADDRESSES=wtn4.com, www.wtn4.com, api.wtn4.com
# 0 لنسخ العملاء: لا حسابات تجريبية بكلمات سرٍّ معروفة (الحسابات بـ provision_instance)
SEED_DEMO=1

# السرّ المشترك مع بوت واتساب — openssl rand -hex 32
# بدونه تبقى الواجهة الداخلية مغلقة 503، وهو السلوك المقصود
INTERNAL_API_KEY=

# مفتاح Cloudflare — به وحده تُصدَر الشهادة الشاملة `*.wtn4.com`، وبها يعمل
# عنوان كل متجر (`islam.wtn4.com`).
#
#   dash.cloudflare.com ← My Profile ← API Tokens ← Create Token
#   ← قالب «Edit zone DNS» ← Zone: wtn4.com ← Create
#
# **مرّةً واحدة وأخيرة** — لا تُفتح Cloudflare عند كل متجر جديد: الشهادة شاملة
# تغطّي كل اسمٍ لم يُخلق بعد. وإن تُرك فارغاً عمل الموقع الرئيسي كما هو
# وتعطّلت عناوين المتاجر وحدها.
CF_API_TOKEN=

# ── النسخة الاحتياطية خارج الخادم ────────────────────────────────────
# وجهةُ rsync — بدونها تبقى النسخة على قرص القاعدة نفسه، فيمحوها ما يمحوها.
#   BACKUP_REMOTE=u123456@u123456.your-storagebox.de:wtn/
BACKUP_REMOTE=

